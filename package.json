{
  "name": "react-tow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nodemon --no-warnings --exec 'node --loader ts-node/esm' server.ts",
    "build": "next build && npx tsc server.ts --esModuleInterop true --moduleResolution node --skipLibCheck true && mv server.js server.cjs",
    "start": "NODE_ENV=production node server.cjs"
  },
  "dependencies": {
    "@supabase/ssr": "latest",
    "@supabase/supabase-js": "latest",
    "autoprefixer": "10.4.17",
    "boring-avatars": "^1.10.2",
    "geist": "^1.2.1",
    "next": "latest",
    "postcss": "8.4.33",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "socket.io": "^4.7.5",
    "socket.io-client": "^4.7.5",
    "tailwindcss": "3.4.1",
    "typescript": "5.3.3",
    "unique-names-generator": "^4.7.1"
  },
  "devDependencies": {
    "@types/node": "^20.11.5",
    "@types/react": "18.2.48",
    "@types/react-dom": "18.2.18",
    "daisyui": "^4.11.1",
    "encoding": "^0.1.13",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.3",
    "ts-node": "^10.9.2"
  }
}